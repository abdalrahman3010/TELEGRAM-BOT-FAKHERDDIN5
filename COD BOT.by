# ========= HARD =========
import hashlib
import sys
import os

EXPECTED_HASH = "#LALA MA3LYKCH "

def check_integrity():
    try:
        with open(__file__, "rb") as f:
            current_hash = hashlib.sha256(f.read()).hexdigest()
        if current_hash != EXPECTED_HASH:
            print("❌ FFFFFF")
            sys.exit(1)
    except Exception:
        print("❌ FFFFFF")
        sys.exit(1)

check_integrity()
#TTTTT


import json
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, MessageHandler, filters, ContextTypes

def get_token():
    token = os.environ.get('TELEGRAM_BOT_TOKEN', '').strip()
    if token:
        return token
    try:
        with open('token.txt', 'r', encoding='utf-8') as f:
            token = f.read().strip()
            if token:
                return token
    except FileNotFoundError:
        pass
    return ''

TOKEN = get_token()
ADMIN_CODE = "111333"
SIGNATURE = "\n\n© @FAKHERDDIN5\nhttps://t.me/stonexff"
DATA_FILE = "bot_data.json"

def load_data():
    try:
        with open(DATA_FILE, "r", encoding='utf-8') as f:
            return json.load(f)
    except:
        return {
            "balances": {},
            "sellers": {},
            "keys": {"FREE": [], "WIZARD": [], "DRIP": [], "CERT": []},
            "sales_log": []
        }

def save_data(data):
    with open(DATA_FILE, "w", encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

PRICES = {
    "FREE": {1: 3, 7: 7, 31: 13},
    "WIZARD": {1: 3, 7: 7, 31: 13},
    "DRIP": {1: 2, 7: 5, 15: 8, 31: 12},
    "CERT": {1: 6}
}

# ========== START ==========
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("🛍️ Buy Keys", callback_data="buy_menu")],
        [InlineKeyboardButton("💰 My Balance", callback_data="show_balance")],
        [InlineKeyboardButton("🔐 Admin Panel", callback_data="admin_login")]
    ]
    await update.message.reply_text(
        "Welcome to Sales Bot! Choose an option below:" + SIGNATURE,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

# ========== CALLBACK HANDLER ==========
async def callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data

    if data == "back_to_start":
        await start(update, context)
        return

    if data == "show_balance":
        user_id = str(query.from_user.id)
        data_dict = load_data()
        bal = data_dict["balances"].get(user_id, 0)
        await query.edit_message_text(f"Your Balance: ${bal}" + SIGNATURE)
        return

    if data == "buy_menu":
        keyboard = [
            [InlineKeyboardButton("🔥 FREE FIRE", callback_data="buy:FREE")],
            [InlineKeyboardButton("✨ WIZARD", callback_data="buy:WIZARD")],
            [InlineKeyboardButton("💧 DRIP", callback_data="buy:DRIP")],
            [InlineKeyboardButton("🎖️ CERTIFICATE", callback_data="buy:CERT")],
            [InlineKeyboardButton("⬅️ Back", callback_data="back_to_start")]
        ]
        await query.edit_message_text("Select product:" + SIGNATURE, reply_markup=InlineKeyboardMarkup(keyboard))
        return

    if data.startswith("buy:"):
        product = data.split(":")[1]
        keyboard = []
        for days, price in sorted(PRICES[product].items()):
            keyboard.append([InlineKeyboardButton(f"{days} Days - ${price}", callback_data=f"pay:{product}:{days}")])
        keyboard.append([InlineKeyboardButton("⬅️ Back", callback_data="buy_menu")])
        await query.edit_message_text(f"Select duration:" + SIGNATURE, reply_markup=InlineKeyboardMarkup(keyboard))
        return

    if data.startswith("pay:"):
        _, product, days = data.split(":")
        days = int(days)
        price = PRICES[product][days]
        user_id = str(query.from_user.id)
        data_dict = load_data()

        if data_dict["balances"].get(user_id, 0) < price:
            await query.edit_message_text("❌ Insufficient balance" + SIGNATURE)
            return

        if not data_dict["keys"][product]:
            await query.edit_message_text("❌ No keys available" + SIGNATURE)
            return

        key = data_dict["keys"][product].pop(0)
        data_dict["balances"][user_id] -= price
        data_dict["sales_log"].append({
            "user": user_id,
            "product": product,
            "days": days,
            "price": price
        })
        save_data(data_dict)
        await query.edit_message_text(f"✅ Your Key:\n`{key}`" + SIGNATURE, parse_mode="Markdown")
        return

# ========== MESSAGE HANDLER ==========
async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    pass

# ========== MAIN ==========
def main():
    if not TOKEN:
        print("❌ Telegram token not set")
        return

    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(callback_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, message_handler))
    print("Bot running...")
    app.run_polling()

if __name__ == "__main__":
    main()


